# Groq LLM API Key (Sign up at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Vector Store Credentials (https://supabase.com)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Tavily Web Search API Key (Sign up at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Minimum Document Retrieval Threshold before triggering Web Search Fallback
DOC_RELEVANCE_THRESHOLD=2
